NODE_ENV=development
PORT=4000
# Comma-separated frontend URLs allowed by CORS (no trailing slash needed)
CLIENT_ORIGIN=http://localhost:5173
# Optional: MongoDB Atlas connection string (server runs in-memory rooms without it)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pixelturf?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-super-secret-jwt-key-pixel-turf
COOKIE_SECURE=false

# Frontend (Vercel) environment variable: URL of the deployed Render backend
VITE_SERVER_URL=https://your-render-service.onrender.com
